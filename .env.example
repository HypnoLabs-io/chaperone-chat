# Read only by the demo (examples/demo) and the command line. The library itself never reads the
# environment: pass these values to createChat().

# Your TypeSafe API key. Leave it empty to run on the rules alone.
TYPESAFE_API_KEY=

# Signs the participants' links. At least 32 characters; the demo makes a throwaway one when empty.
CHAT_LINK_SECRET=

# Postgres for the demo. Empty: the in-memory store.
DATABASE_URL=

# The demo's port.
PORT=3000
